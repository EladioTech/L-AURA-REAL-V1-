5260 PRINT "2-PISO APARTAM. (3000)  ALQ: +180"
5290 PRINT "3-LOCAL COMERC. (7000)  ALQ: +450"
5350 PRINT "4-SALIR"
5370 LET entradaA = INPUT(1)
5380 LET A=VAL(entradaA)
5390 IF A=1 THEN GOTO 5400
5395 IF A=2 THEN GOTO 5500
5397 IF A=3 THEN GOTO 5600
5399 GOTO 1000

5400 IF DINERO<800 THEN PRINT "NO TIENES DINERO": PAUSE 100: GOTO 5200
