5600 IF DINERO<7000 THEN PRINT "NO TIENES DINERO": PAUSE 100: GOTO 5200
5610 LET DINERO=DINERO-7000: LET LOCALES=LOCALES+1: LET PASIVOS=PASIVOS+450
5640 PRINT "COMPRAS UN LOCAL": GOSUB 9200: PAUSE 100: GOTO 1000

