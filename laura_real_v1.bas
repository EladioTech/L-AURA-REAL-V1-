4015 PRINT "HIPOTECA: -"; HIPOTECA

4016 LET DINERO=DINERO+SUELDO+PASIVOS-GASTOS-HIPOTECA
4017 LET BURNOUT=BURNOUT+INT(ESTRES/10)
