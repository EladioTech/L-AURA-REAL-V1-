#include <input.bas>

1 REM === L-AURA REAL V1 ===
2 RANDOMIZE

5 REM === DECLARACIÓN DE VARIABLES INTERNAS ===
6 DIM MES, ANO, INVERSION, DINERO, BANCO, DEUDA AS INTEGER
7 DIM SUELDO, GASTOS, HIPOTECA, PASIVOS, FONDO, INFLA AS INTEGER
8 DIM SALUD, ESTRES, NIVEL, REPUT AS INTEGER
9 DIM RENT, INTERES, PARO, AYUDA AS INTEGER
91 DIM A, F, I AS INTEGER
92 DIM entradaA, entradaF, entradaI AS STRING

10 LET MES=1
11 LET ANO=2026
12 LET INVERSION=0
20 LET DINERO=500
21 LET BANCO=0
22 LET DEUDA=40000

30 LET SUELDO=1200
31 LET GASTOS=600
32 LET HIPOTECA=300
33 LET PASIVOS=0
34 LET FONDO=0
35 LET INFLA=2
40 LET SALUD=80
41 LET ESTRES=20

50 LET NIVEL=1
51 LET REPUT=100

100 GOTO 1000


1000 REM === PANTALLA PRINCIPAL ===
1010 CLS

1020 PRINT "L-AURA REAL V1"
1030 PRINT "----------------------------"

1040 PRINT "MES: "; MES; " / "; ANO
1050 PRINT ""

1060 PRINT "DINERO: "; DINERO
1070 PRINT "BANCO: "; BANCO
1080 PRINT "DEUDA: "; DEUDA

1090 PRINT "----------------------------"

1100 PRINT "SUELDO: "; SUELDO
1110 PRINT "PASIVOS: "; PASIVOS

1120 PRINT "GASTOS: "; GASTOS
1130 PRINT "HIPOTECA: "; HIPOTECA

1140 PRINT "----------------------------"

1150 PRINT "SALUD: "; SALUD
1160 PRINT "ESTRES: "; ESTRES
1170 PRINT "NIVEL: "; NIVEL

1180 PRINT "----------------------------"

1190 IF PASIVOS>=HIPOTECA+GASTOS THEN PRINT "LIBERTAD CERCA"
1195 IF DINERO<0 THEN PRINT "PELIGRO FINANCIERO"

1200 PRINT ""
1210 PRINT "1-TRABAJAR MAS"
1220 PRINT "2-AHORRAR"
1230 PRINT "3-FORMACION"
1240 PRINT "4-COMPRAR ACTIVO"
1250 PRINT "5-AMORTIZAR"
1260 PRINT "6-FIN DE MES"
1265 PRINT "7-FONDO EMERGENCIA"
1266 PRINT "8-INVERTIR"

1270 PRINT ""

1280 LET entradaA = INPUT(1)
1290 LET A=VAL(entradaA)

1300 IF A=1 THEN GOTO 2000
1310 IF A=2 THEN GOTO 3000
1320 IF A=4 THEN GOTO 5000
1330 IF A=5 THEN GOTO 6000
1340 IF A=6 THEN GOTO 7000
1350 IF A=7 THEN GOTO 7500
1360 IF A=8 THEN GOTO 7800

1370 GOTO 1000

2000 REM === TRABAJAR ===
2010 CLS
2020 PRINT "TRABAJAS HORAS EXTRA"
2030 LET DINERO=DINERO+200
2040 LET ESTRES=ESTRES+5
2050 PRINT "+200 DINERO"
2060 PAUSE 100
2070 GOTO 1000

3000 REM === AHORRAR ===
3010 CLS
3020 PRINT "GUARDAS 100 EN BANCO"

3030 IF DINERO<100 THEN PRINT "NO TIENES DINERO": PAUSE 100: GOTO 1000

3040 LET DINERO=DINERO-100
3050 LET BANCO=BANCO+100

3060 PAUSE 100
3070 GOTO 1000

4000 REM === FIN DE MES ===

4005 CLS
4010 PRINT "====== FIN DE MES ======"
4015 PRINT ""

4020 REM --- RENTABILIDAD INVERSION ---
4030 LET RENT=INT(INVERSION/20)

4040 IF RENT>0 THEN PRINT "RENTABILIDAD: +"; RENT

4050 LET INVERSION=INVERSION+RENT
4060 LET DINERO=DINERO+PASIVOS

4070 REM --- INTERES BANCO ---
4080 LET INTERES=INT(BANCO/50)

4090 IF INTERES>0 THEN PRINT "INTERES BANCO: +"; INTERES

4100 LET BANCO=BANCO+INTERES

4110 REM --- PAGOS ---
4120 PRINT "HIPOTECA: -"; HIPOTECA
4130 LET DINERO=DINERO-HIPOTECA

4140 PRINT "GASTOS BASICOS: -"; GASTOS
4150 LET DINERO=DINERO-GASTOS

4160 REM --- INFLACION ---
4170 LET GASTOS=INT(GASTOS*(1+INFLA/100))
4180 LET HIPOTECA=INT(HIPOTECA*(1+INFLA/200))

4190 PRINT ""
4200 PRINT "INFLACION: "; INFLA; "%"

4210 PRINT ""
4220 PRINT "DINERO FINAL: "; DINERO
4230 PRINT "BANCO FINAL: "; BANCO

4240 REM --- CRISIS ---
4250 IF DINERO>=0 THEN GOTO 4300

4260 PRINT ""
4270 PRINT "NO PUEDES PAGAR TODO"
4280 PRINT "ENTRAS EN DEUDAS"

4290 LET SALUD=SALUD-10
4300 LET DEUDA=DEUDA+100

4310 REM --- AVANCE TIEMPO ---
4320 PRINT ""
4330 PRINT "PULSA UNA TECLA..."
4340 PAUSE 0

4350 LET MES=MES+1

4360 IF MES<=12 THEN GOTO 4390

4370 LET MES=1
4380 LET ANO=ANO+1

4390 IF INT(RND*12)=1 THEN GOSUB 9500

4400 GOTO 1000

5000 REM === ACTIVOS ===
5010 CLS
5020 PRINT "COMPRAS ACTIVO"

5030 IF DINERO<500 THEN PRINT "NO TIENES 500": PAUSE 100: GOTO 1000

5040 LET DINERO=DINERO-500
5050 LET PASIVOS=PASIVOS+50

5060 PRINT "PASIVOS +50"

5070 PAUSE 100
5080 GOTO 1000

6000 REM === AMORTIZAR ===
6010 CLS
6020 PRINT "AMORTIZAS 1000"

6030 IF DINERO<1000 THEN PRINT "NO TIENES 1000": PAUSE 100: GOTO 1000

6040 LET DINERO=DINERO-1000
6050 LET DEUDA=DEUDA-1000

6060 PRINT "DEUDA REDUCIDA"

6070 PAUSE 100
6080 GOTO 1000

7000 GOTO 4000
7500 CLS
7510 PRINT "=== FONDO EMERGENCIA ==="
7520 PRINT ""
7530 PRINT "AHORRO PROTEGIDO."
7540 PRINT "SOLO PARA CRISIS."
7550 PRINT ""
7560 PRINT "FONDO ACTUAL: "; FONDO
7570 PRINT ""
7580 PRINT "1-GUARDAR 100"
7590 PRINT "2-SALIR"
7600 LET entradaF = INPUT(1)
7605 LET F=VAL(entradaF)

7610 IF F<>1 THEN GOTO 1000

7620 IF DINERO<100 THEN PRINT "NO TIENES DINERO": PAUSE 100: GOTO 1000

7630 LET DINERO=DINERO-100
7640 LET FONDO=FONDO+100

7650 PRINT ""
7660 PRINT "FONDO +100"
7670 PRINT "TOTAL: "; FONDO

7680 GOSUB 9000
7690 GOTO 4000

7800 CLS
7810 PRINT "=== INVERSION ==="
7820 PRINT ""
7830 PRINT "DINERO TRABAJANDO."
7840 PRINT ""
7850 PRINT "INVERSION ACTUAL: "; INVERSION
7860 PRINT ""
7870 PRINT "1-INVERTIR 500"
7880 PRINT "2-SALIR"

7890 LET entradaI = INPUT(1)
7895 LET I=VAL(entradaI)

7900 IF I<>1 THEN GOTO 1000

7910 IF DINERO<500 THEN PRINT "NO TIENES 500": PAUSE 100: GOTO 1000

7920 LET DINERO=DINERO-500
7930 LET INVERSION=INVERSION+500

7940 PRINT ""
7950 PRINT "INVERSION REALIZADA."

7960 GOSUB 9000
7970 GOTO 4000


9000 REM === CONSEJOS ===
9010 PRINT ""

9020 IF DINERO<200 THEN PRINT "PELIGRO FINANCIERO"

9030 IF BANCO>1000 THEN PRINT "BUEN COLCHON"

9040 IF PASIVOS>HIPOTECA THEN PRINT "LIBERTAD CERCA"

9050 RETURN








9500 REM === EVENTO DESEMPLEO ===

9510 CLS
9520 PRINT "====== DESEMPLEO ======"
9530 PRINT ""

9540 PRINT "LA EMPRESA RECORTA PERSONAL."
9550 PRINT "TE QUEDAS SIN TRABAJO."
9560 PRINT ""

9570 LET PARO=INT(RND*2)

9580 IF PARO=0 THEN GOTO 9700
9590 GOTO 9800

9700 REM --- SIN AYUDA ---
9710 PRINT "NO RECIBES AYUDA."

9715 IF FONDO>=200 THEN GOTO 9750

9720 PRINT "NO TIENES COLCHON."
9730 PRINT "ESTAS SOLO."

9740 LET SALUD=SALUD-10
9745 LET REPUT=REPUT-5
9747 GOTO 9900

9750 PRINT "USAS EL FONDO EMERGENCIA."
9760 LET FONDO=FONDO-200
9770 LET DINERO=DINERO+200
9780 PRINT "EL GOLPE NO TE HUNDE."
9790 GOTO 9900

9800 REM --- CON AYUDA ---
9810 LET AYUDA=250
9820 PRINT "RECIBES AYUDA TEMPORAL."
9830 PRINT "COBRAS "; AYUDA
9840 PRINT ""
9850 LET DINERO=DINERO+AYUDA
9860 LET REPUT=REPUT-2

9900 PRINT ""
9910 PRINT "PULSA UNA TECLA..."
9920 PAUSE 0
9930 RETURN
